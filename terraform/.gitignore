# Local .terraform directories
**/.terraform/*

# .tfstate files (contain sensitive infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (often contain secrets/credentials)
*.tfvars
*.tfvars.json
*.env
# Ignore override files (usually local overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore all text files
*.txt
